# NyotaOne application
PORT=3000
NODE_ENV=development

# MariaDB connection
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=nyotaone_db
DB_USER=nyotaone_app
DB_PASSWORD=replace_with_your_database_password

# Authentication
JWT_SECRET=replace_with_a_long_random_secret

# Plesk API integration
# Set these only after confirming the Plesk server/API details.
PLESK_BASE_URL=https://your-plesk-server.example:8443
PLESK_API_KEY=replace_with_your_plesk_api_key
PLESK_VERIFY_TLS=true

# Email notifications (configure later)
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
